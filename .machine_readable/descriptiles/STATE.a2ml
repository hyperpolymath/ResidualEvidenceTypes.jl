# STATE.a2ml — project state checkpoint for ResidualEvidenceTypes.jl.

[metadata]
project = "ResidualEvidenceTypes.jl"
version = "0.1.0"
last-updated = "2026-09-30"
# AUTHORITY: when this and CLADE [status] phase disagree, CLADE phase is the
# authoritative SCM checkpoint and STATE must be re-derived from it.
status = "active"

[project-context]
name = "ResidualEvidenceTypes.jl"
purpose = "Executable companion to residual-evidence-types: finite candidate sets, verdicts with witnesses, and value identification."
completion-percentage = 30

[position]
phase = "implementation"   # design | implementation | testing | maintenance | archived
maturity = "experimental"  # experimental | alpha | beta | production | lts

[route-to-mvp]
milestones = [
  { name = "Generic finite checker: Case, candidates, holds, identify", completion = 100 },
  { name = "signed-integer-v1 model and the 546-row table", completion = 100 },
  { name = "Cross-check against residual-evidence-types' generated ExplorerTable", completion = 100 },
  { name = "Refinement (adding evidence) and its monotonicity checks", completion = 0 },
  { name = "Composition of independent residuals", completion = 0 },
]

[blockers-and-issues]
# The ExplorerTable fixture comes from residual-evidence-types branch
# feat/phase3-harness, which is not yet merged. Re-pin when it lands on main.

[critical-next-actions]
actions = [
  "Re-pin test/fixtures/ExplorerTable.agda to residual-evidence-types main once the correspondence harness merges",
]

[maintenance-status]
last-run-utc = "never"
last-report = "docs/reports/maintenance/latest.json"
last-result = "unknown"
open-warnings = 0
open-failures = 0

[ecosystem]
part-of = ["nextgen-typing"]
depends-on = []
